# Azure CLI profile and account used for Entra authentication.
# Use an absolute path for AZURE_CONFIG_DIR.
AZURE_CONFIG_DIR=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Existing Azure Speech resource.
AZURE_SPEECH_AUTH_MODE=azure-cli
AZURE_SPEECH_RESOURCE_NAME=
# Optional alternative to AZURE_SPEECH_RESOURCE_NAME:
AZURE_SPEECH_ENDPOINT=

# Optional only when the resource permits local key authentication.
# AZURE_SPEECH_KEY=

# Demo behavior.
AZURE_SPEECH_TARGET_LANGUAGE=fr
# Optional. Defaults include en-US-Ava:DragonHDLatestNeural with Czech language skill.
# Set to personal-voice only when the Speech resource has Personal Voice access.
AZURE_SPEECH_VOICE=
AZURE_SPEECH_INPUT_WAV=
AZURE_SPEECH_OUTPUT_WAV=translated.wav
AZURE_SPEECH_TIMEOUT=120
